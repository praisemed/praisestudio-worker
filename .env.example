# Copy this to .env for local testing, or set these as environment variables
# in your Railway/Render project settings.

PORT=3000

# From Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Note: no LOVABLE_WEBHOOK_URL or WORKER_WEBHOOK_SECRET needed here.
# Lovable sends callbackUrl + callbackSecret with EVERY request it makes,
# so the worker just uses whatever it's given per-job.

# Needed only for the subtitles endpoint
OPENAI_API_KEY=sk-...
