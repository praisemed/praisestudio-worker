# Copy this to .env for local testing, or set these as environment variables
# in your Railway project settings.

PORT=3000

# Only needed for the subtitles endpoint
OPENAI_API_KEY=sk-...

# Nothing else is needed. The worker never talks to Supabase directly --
# it sends finished files to Lovable's own POST /api/upload-job-result
# endpoint, using the callbackUrl + callbackSecret Lovable sends with
# every job request. Lovable handles all storage on its side.
