# Copy this to .env for local testing, or set these as environment variables
# in your Railway/Render project settings.

PORT=3000

# From Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# The Lovable app's webhook that receives job status updates
LOVABLE_WEBHOOK_URL=https://your-app.lovable.app/api/job-update

# Needed only for the subtitles endpoint
OPENAI_API_KEY=sk-...
